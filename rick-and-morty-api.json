{
	"info": {
		"_postman_id": "rick-and-morty-api-tests",
		"name": "Rick and Morty API",
		"description": "Comprehensive test suite for the Rick and Morty API with extensive test cases",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://rickandmortyapi.com/api"
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test('Response time is acceptable', function() {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});"
				]
			}
		}
	],
	"item": [
		{
			"name": "Characters",
			"item": [
				{
					"name": "List All Characters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
									"pm.test('Response has info object', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('info');",
									"});",
									"pm.test('Response has results array', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"});",
									"pm.test('First character has required properties', function() {",
									"    const jsonData = pm.response.json();",
									"    const char = jsonData.results[0];",
									"    pm.expect(char).to.have.property('id'); pm.expect(char).to.have.property('name'); pm.expect(char).to.have.property('status'); pm.expect(char).to.have.property('species');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/character", "host": ["{{baseUrl}}"], "path": ["character"] }
					},
					"response": []
				},
				{
					"name": "Get Character by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
									"pm.test('Character has all properties', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number'); pm.expect(jsonData.name).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/character/1", "host": ["{{baseUrl}}"], "path": ["character", "1"] }
					},
					"response": []
				},
				{
					"name": "Get Character by Invalid ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 404', function() { pm.response.to.have.status(404); });",
									"pm.test('Error response', function() {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('error');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/character/999999999", "host": ["{{baseUrl}}"], "path": ["character", "999999999"] }
					},
					"response": []
				},
				{
					"name": "Filter Characters by Name",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
									"pm.test('Results contain Rick', function() {",
									"    const jsonData = pm.response.json();",
									"    const found = jsonData.results.some(c => c.name.toLowerCase().includes('rick'));",
									"    pm.expect(found).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/character?name=Rick", "host": ["{{baseUrl}}"], "path": ["character"], "query": [{"key": "name", "value": "Rick"}] }
					},
					"response": []
				},
				{
					"name": "Filter Characters by Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function() { pm.response.to.have.status(200); });",
									"pm.test('All characters are Alive', function() {",
									"    const jsonData = pm.response.json();",
									"    const allAlive = jsonData.results.every(c => c.status === 'Alive');",
									"    pm.expect(allAlive).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/character?status=alive", "host": ["{{baseUrl}}"], "path": ["character"], "query": [{"key": "status", "value": "alive"}] }
					},
					"response": []
				},
