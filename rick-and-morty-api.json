											"    const jsonData = pm.response.json();",
											"    pm.expect(jsonData).to.have.property('results');",
											"    pm.expect(jsonData.results).to.be.an('array');",
											"    pm.expect(jsonData.results.length).to.be.greaterThan(0);",
											"});",
											"",
											"pm.test('First character has required properties', function() {",
											"    const jsonData = pm.response.json();",
											"    const firstCharacter = jsonData.results[0];",
											"    pm.expect(firstCharacter).to.have.property('id');",
											"    pm.expect(firstCharacter).to.have.property('name');",
											"    pm.expect(firstCharacter).to.have.property('status');",
											"    pm.expect(firstCharacter).to.have.property('species');",
											"    pm.expect(firstCharacter).to.have.property('type');",
											"    pm.expect(firstCharacter).to.have.property('gender');",
