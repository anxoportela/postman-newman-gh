{
	"info": {
		"_postman_id": "rick-and-morty-api-tests",
		"name": "Rick and Morty API - Comprehensive Tests",
		"description": "Advanced API test suite demonstrating Postman/Newman features",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "https://rickandmortyapi.com/api" }
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test - response time",
					"pm.test('Global: Response time < 3s', function() {",
					"    pm.expect(pm.response.responseTime).to.be.below(3000);",
					"});",
					"",
					"// Global test - status code (skip for expected errors)",
					"pm.test('Global: Status code is success', function() {",
					"    if (pm.response.code !== 404) {",
					"        pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
					"    }",
					"});"
				]
			}
		},
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set timestamp for tracking",
					"pm.environment.set('requestTimestamp', Date.now());"
				]
			}
		}
	],
	"item": [
		{
			"name": "Characters - Advanced Tests",
			"item": [
				{
					"name": "1. List All Characters with Pagination",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"",
									"// Validate response structure",
									"pm.test('Response has info with pagination', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.info).to.have.property('count');",
									"    pm.expect(json.info).to.have.property('pages');",
									"    pm.expect(json.info.pages).to.be.above(0);",
									"});",
									"",
									"// Validate results array",
									"pm.test('Results is an array with items', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.results).to.be.an('array');",
									"    pm.expect(json.results.length).to.be.greaterThan(0);",
									"});",
									"",
									"// Save data for chained requests",
									"pm.test('Save first character ID for next test', () => {",
									"    const json = pm.response.json();",
									"    pm.environment.set('savedCharacterId', json.results[0].id);",
									"    pm.environment.set('savedCharacterName', json.results[0].name);",
									"    pm.expect(json.results[0].id).to.be.a('number');",
									"});",
									"",
									"// Validate character structure with schema-like check",
									"pm.test('Character has all required fields', () => {",
									"    const json = pm.response.json();",
									"    const char = json.results[0];",
									"    pm.expect(char.id).to.be.a('number');",
									"    pm.expect(char.name).to.be.a('string');",
									"    pm.expect(char.status).to.be.oneOf(['Alive', 'Dead', 'unknown']);",
									"    pm.expect(char.species).to.be.a('string');",
									"    pm.expect(char.gender).to.be.oneOf(['Male', 'Female', 'Genderless', 'unknown']);",
									"    pm.expect(char.origin).to.be.an('object');",
									"    pm.expect(char.location).to.be.an('object');",
									"    pm.expect(char.image).to.include('http');",
									"});",
									"",
									"// Response contains headers check",
									"pm.test('Has Content-Type header', () => {",
									"    pm.response.to.have.header('Content-Type');",
									"});"
								]
							}
						}
					],
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/character", "host": ["{{baseUrl}}"], "path": ["character"] } },
					"response": []
				},
				{
					"name": "2. Get Character by ID (Using Variable)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"",
									"// Use saved variable",
									"pm.test('Character ID matches saved value', () => {",
									"    const json = pm.response.json();",
									"    const savedId = pm.environment.get('savedCharacterId');",
									"    pm.expect(json.id).to.equal(savedId);",
									"});",
									"",
									"// Validate name from saved variable",
									"pm.test('Character name matches saved value', () => {",
									"    const json = pm.response.json();",
									"    const savedName = pm.environment.get('savedCharacterName');",
									"    pm.expect(json.name).to.equal(savedName);",
									"});",
									"",
									"// Type validation",
									"pm.test('Character fields have correct types', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(typeof json.id).to.equal('number');",
									"    pm.expect(typeof json.name).to.equal('string');",
									"    pm.expect(typeof json.status).to.equal('string');",
									"    pm.expect(typeof json.created).to.equal('string');",
									"});",
									"",
									"// URL validation",
									"pm.test('Character URLs are valid', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.url).to.include('rickandmortyapi');",
									"    pm.expect(json.image).to.include('http');",
									"});"
								]
							}
						}
					],
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/character/{{savedCharacterId}}", "host": ["{{baseUrl}}"], "path": ["character", "{{savedCharacterId}}"] } },
					"response": []
				},
				{
					"name": "3. Filter Characters - Multiple Filters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"",
									"// Filter by name - partial match",
									"pm.test('Results contain Rick', () => {",
									"    const json = pm.response.json();",
									"    const found = json.results.some(c => c.name.toLowerCase().includes('rick'));",
									"    pm.expect(found).to.be.true;",
									"});",
									"",
									"// Filter validation - all characters alive",
									"pm.test('All characters are Alive', () => {",
									"    const json = pm.response.json();",
									"    const allAlive = json.results.every(c => c.status === 'Alive');",
									"    pm.expect(allAlive).to.be.true;",
									"});",
									"",
									"// Count validation",
									"pm.test('Results count matches info', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.results.length).to.be.at.most(20);",
									"});",
									"",
									"// Multiple assertions in one test",
									"pm.test('All characters have valid properties', () => {",
									"    const json = pm.response.json();",
									"    json.results.forEach(char => {",
									"        pm.expect(char.id).to.be.a('number');",
									"        pm.expect(char.name).to.be.a('string');",
									"        pm.expect(['Alive', 'Dead', 'unknown']).to.include(char.status);",
									"    });",
									"});"
								]
							}
						}
					],
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/character?name=Rick&status=alive", "host": ["{{baseUrl}}"], "path": ["character"], "query": [{"key": "name", "value": "Rick"}, {"key": "status", "value": "alive"}] } },
					"response": []
				},
				{
					"name": "4. Pagination Test",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"",
									"// First page has next",
									"pm.test('Page 1 has next page', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.info.next).to.not.equal(null);",
									"});",
									"",
									"// Previous is null for first page",
									"pm.test('Page 1 has no previous', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.info.prev).to.equal(null);",
									"});",
									"",
									"// Different characters on different pages",
									"pm.test('Results are unique', () => {",
									"    const json = pm.response.json();",
									"    const ids = json.results.map(c => c.id);",
									"    const uniqueIds = [...new Set(ids)];",
									"    pm.expect(ids.length).to.equal(uniqueIds.length);",
									"});"
								]
							}
						}
					],
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/character?page=1", "host": ["{{baseUrl}}"], "path": ["character"], "query": [{"key": "page", "value": "1"}] } },
					"response": []
				},
				{
					"name": "5. Get Multiple Characters",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
									"",
									"// Returns array",
									"pm.test('Response is an array', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.be.an('array');",
									"});",
									"",
									"// Correct count",
									"pm.test('Returns 3 characters', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json.length).to.equal(3);",
									"});",
									"",
									"// Order preserved",
									"pm.test('Characters in correct order', () => {",
									"    const json = pm.response.json();",
									"    pm.expect(json[0].id).to.equal(1);",
									"    pm.expect(json[1].id).to.equal(2);",
									"    pm.expect(json[2].id).to.equal(3);",
									"});"
								]
							}
						}
					],
					"request": { "method": "GET", "url": { "raw": "{{baseUrl}}/character/1,2,3", "host": ["{{baseUrl}}"], "path": ["character", "1,2,3"] } },
					"response": []
				}
			]
		},
